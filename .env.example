NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=development

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-at-least-32-character-secret
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGIN=http://localhost:8081
JSON_BODY_LIMIT=20kb
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
FORGOT_PASSWORD_RATE_LIMIT_MAX=5
PASSWORD_RESET_EXPIRES_IN_MINUTES=30
EMAIL_VERIFICATION_EXPIRES_IN_MINUTES=1440
EMAIL_OTP_SECRET=replace-with-a-separate-at-least-32-character-secret
EMAIL_OTP_EXPIRES_IN_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
APP_URL=daterra://
